        <dip name="Quarter Coinage" bits="2,3" ids="2C/1C,1C/1C,1C/1C (no display),1C/2C" values="2,1,0,3"/>
        <dip name="Lives" bits="4,5" ids="2,3,4,5" values="3,2,1,0"/>
        <dip name="Currency" bits="6" ids="Quarters,Pence" values="1,0"/>
        <dip name="Language" bits="8,9" ids="English,French,German,Spanish"/>
    </switches>

